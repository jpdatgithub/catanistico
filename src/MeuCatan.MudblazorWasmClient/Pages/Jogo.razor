@page "/jogo/{SalaId:int}"
@implements IAsyncDisposable

@inject ClienteAuthService AuthService
@inject HttpClient Http
@inject Microsoft.AspNetCore.Components.WebAssembly.Hosting.IWebAssemblyHostEnvironment HostEnvironment
@using MeuCatan.MudblazorWasmClient.Components.Catan
@using System.Text.Json

<PageTitle>Jogo</PageTitle>

<div class="game-page-shell">
    <div class="game-page px-4">
        @if (_carregando && _session is null)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        }
        else if (_session is null)
        {
            <MudAlert Severity="Severity.Error">@(_erro ?? "Sessão de jogo não encontrada.")</MudAlert>
        }
        else
        {
            var currentPlayer = _session.Players.FirstOrDefault(player => player.UsuarioId == _session.YourPlayerId);

            <div class="game-layout">
                <main class="game-board-column">
                    <section class="game-board-surface pa-4">
                        @* <MudText Typo="Typo.h5" Class="mb-2">Tabuleiro de Catan</MudText>
                        <MudText Typo="Typo.body2" Class="mb-4">
                            Este primeiro corte já carrega uma sessão real e um board SVG do Catan. As ações interativas de
                            colocação inicial entram no próximo passo.
                        </MudText>

                        <MudText Typo="Typo.body2" Class="mb-2">
                            Quando o setup estiver no seu turno, clique no destaque verde para executar sua ação: vértice para
                            aldeia e aresta para estrada.
                        </MudText> *@

                        <div class="game-board-viewport">
                            @if (_session.CatanState is not null)
                            {
                                <CatanBoardSvg State="_session.CatanState" FillParent="true"
                                               PlayerColorsById="@_session.Players.ToDictionary(player => player.UsuarioId, player => player.Cor)"
                                               OnVertexClicked="HandleVertexClickAsync" OnEdgeClicked="HandleEdgeClickAsync"
                                               OnTileClicked="HandleTileClickAsync" HighlightedVertexIds="@HighlightedVertexIds"
                                               HighlightedEdgeKeys="@HighlightedEdgeKeys" HighlightedTileIds="@HighlightedTileIds" />
                            }

                            @if (currentPlayer is not null && _isTradeOpen)
                            {
                                <ResourceTradePanel Player="currentPlayer" IsOpen="true"
                                                    OfferedResources="_selectedTradeResources" Bank="_session.CatanState?.Bank"
                                                    AskedResources="_askedTradeResources" OnClose="FecharInterfaceTrocaAsync"
                                                    OnSelectedResourceClicked="RemoverRecursoDaTrocaAsync" OnOffer="ExecutarOfertaTrocaAsync"
                                                    OnBankTrade="ExecutarTrocaBancoAsync" />
                            }

                            @if (currentPlayer is not null && TemDescartePendente)
                            {
                                <ResourceDiscardPanel Player="currentPlayer" IsOpen="true"
                                                      RequiredAmount="@QuantidadeDescartePendente" SelectedResources="_selectedDiscardResources"
                                                      OnSelectedResourceClicked="RemoverRecursoDoDescarteAsync"
                                                      OnConfirm="ExecutarDescarteAsync" />
                            }

                            @if (TemSelecaoRecursoCartaDesenvolvimento)
                            {
                                <DevelopmentResourceSelectionPanel RequiredAmount="@QuantidadeRecursosCartaDesenvolvimento"
                                                                   SelectedResources="_selectedDevelopmentCardResources"
                                                                   OnResourceSelected="AdicionarRecursoCartaDesenvolvimentoAsync"
                                                                   OnResourceRemoved="RemoverRecursoCartaDesenvolvimentoAsync"
                                                                   OnConfirm="ConfirmarCartaDesenvolvimentoAsync" />
                            }

                            @if (VitimasElegiveisDoLadrao.Count > 1)
                            {
                                <RobberVictimSelectionPanel Victims="VitimasElegiveisDoLadrao"
                                                            SelectedPlayerId="_selectedRobberVictimPlayerId"
                                                            OnVictimSelected="SelecionarVitimaDoLadraoAsync"
                                                            OnConfirm="ExecutarEscolhaVitimaLadraoAsync" />
                            }

                            <OfferViewPanelStack Offers="OfertasAtivas" ViewerColor="@currentPlayer?.Cor"
                                                 ViewerPlayerId="@_session.YourPlayerId" Players="@_session.Players"
                                                 OnAccept="ExecutarAceiteOfertaTrocaAsync" OnDecline="ExecutarRecusaOfertaTrocaAsync"
                                                 OnExecute="ExecutarTrocaEntreJogadoresAsync" />

                            <div class="game-board-overlay-turn-legend">
                                <LegendaDoTurno Session="@_session" />
                            </div>

                            @if (_session.Phase == GameTipoFase.Turno && _session.CatanState is not null)
                            {
                                <div class="game-board-overlay-actions">
                                    <MudStack Row="true" Spacing="1" Class="resource-actions">
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="dice-action-button"
                                                   Disabled="@(!PodeRolarDados)" OnClick="ExecutarRolagemDadosAsync">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                <DiceFace Value="@(_session.CatanState.LastDice1 ?? 6)" Size="36" />
                                                <DiceFace Value="@(_session.CatanState.LastDice2 ?? 6)" Size="36" />
                                            </MudStack>
                                        </MudButton>

                                        <MudIconButton Icon="@Icons.Material.Filled.SkipNext" Variant="Variant.Filled"
                                                       Color="Color.Primary" Class="skip-turn-button" Disabled="@(!PodePassarTurno)"
                                                       OnClick="ExecutarPassarTurnoAsync" aria-label="Passar turno" />
                                    </MudStack>
                                </div>
                            }
                        </div>

                        @if (currentPlayer is not null)
                        {
                            <div class="game-resource-bar">
                                <div class="game-resource-bar-contents">
                                    <div class="game-resource-panel-slot">
                                        <PlayerResourcePanel Player="currentPlayer"
                                                             SelectedResources="RecursosSelecionadosNaMao" CanInteract="@PodeInteragirComMao"
                                                             OnResourceClicked="HandleCliqueRecursoDaMaoAsync" />
                                    </div>

                                    <div class="game-development-cards-slot">
                                        <PlayerDevelopmentCardsPanel Player="currentPlayer" CanPlayKnight="@PodeJogarCavaleiro"
                                                                     CanPlayRoadBuilder="@PodeJogarConstrutorEstradas"
                                                                     CanPlayPlus2Resources="@PodeJogarMaisDoisRecursos"
                                                                     CanPlayMonopoly="@PodeJogarMonopolio"
                                                                     OnCardClicked="HandleCliqueCartaDesenvolvimentoAsync" />
                                    </div>

                                    <div class="game-action-panel-slot">
                                        <BuildActionPanel PlayerColor="@PlayerColorUtils.ToHex(currentPlayer.Cor)"
                                                          PlayerResources="@currentPlayer.Resources" Disabled="@(!PodeInteragirComRecursos)"
                                                          CanBuyDevelopmentCard="@PodeComprarCartaDesenvolvimento"
                                                          ActiveBuildMode="@_buildMode"
                                                          OnDevelopmentClicked="ExecutarCompraCartaDesenvolvimentoAsync"
                                                          OnRoadClicked="EntrarModoEstrada" OnCityClicked="EntrarModoCidade"
                                                          OnVillageClicked="EntrarModoVilarejo" />
                                    </div>
                                </div>
                            </div>
                        }
                    </section>
                </main>

                <aside class="game-sidebar-column">
                    <div class="game-sidebar-content">
                        @* <MudPaper Class="pa-4">
                            <MudText Typo="Typo.h6">Sessão</MudText>
                            <MudText Typo="Typo.body2">Sala: @_session.SalaId</MudText>
                            <MudText Typo="Typo.body2">Jogo: @_session.GameType</MudText>
                            <MudText Typo="Typo.body2">Fase: @FormatarFase(_session.Phase)</MudText>
                            <MudText Typo="Typo.body2">Turno atual: @_session.CurrentPlayerNome</MudText>
                            <MudText Typo="Typo.body2">Você pode agir: @(_session.CanCurrentUserAct ? "sim" : "não")
                            </MudText>
                        </MudPaper> *@

                        

                        <section class="game-activity-panel pa-3">
                            <GameRollHistoryPanel Players="@_session.Players"
                                                  RollHistory="@_session.CatanState?.RollHistory"
                                                  RobberTheftHistory="@_session.CatanState?.RobberTheftHistory"
                                                  KnightPlayHistory="@_session.CatanState?.KnightPlayHistory"
                                                  PlayerTradeHistory="@_session.CatanState?.PlayerTradeHistory" />

                            <hr class="game-activity-divider my-2" />

                            <GameChatPanel SalaId="@SalaId" />

                            <BankStatePanel Bank="@_session.CatanState?.Bank" />

                            <div class="game-player-status-list" role="list">
                                @foreach (var player in _session.Players)
                                {
                                    <div class="game-player-status-item @(player.IsCurrentTurn ? "is-current-turn" : string.Empty)"
                                         role="listitem">
                                        <PlayerStatusListItem Player="player" />
                                    </div>
                                }
                            </div>
                        </section>
                    </div>
                </aside>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public int SalaId { get; set; }

    private GameSessionResponse? _session;
    private string? _erro;
    private string? _acaoErro;
    private bool _carregando;
    private CancellationTokenSource? _pollingCancellation;
    private Task? _pollingTask;
    private Task? _offerExpiryTask;
    private HubConnection? _stateHubConnection;
    private DateTime _pollingRapidoAteUtc;
    private DateTime _ultimoHeartbeatSalaUtc = DateTime.MinValue;
    private string _sessionDebugJson = "null";
    private string _catanStateDebugJson = "null";
    private bool _isTradeOpen;
    private readonly Dictionary<string, int> _selectedTradeResources = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, int> _askedTradeResources = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, int> _selectedDiscardResources = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, int> _selectedDevelopmentCardResources = new(StringComparer.OrdinalIgnoreCase);
    private int? _selectedRobberVictimPlayerId;
    private string? _buildMode;
    private string? _developmentResourceSelectionCardType;
    // Keep heavy state serialization opt-in even in development builds.
    private const bool EnableDebugStatePanelInDevelopment = false;
    private const int PollingNormalMs = 2000;
    private const int PollingRapidoMs = 600;
    private static readonly TimeSpan JanelaPollingRapido = TimeSpan.FromSeconds(6);
    private static readonly TimeSpan HeartbeatSalaInterval = TimeSpan.FromSeconds(12);
    private static readonly JsonSerializerOptions _jsonDebugOptions = new()
    {
        WriteIndented = true
    };

    private bool DebugStatePanelEnabled => string.Equals(HostEnvironment.Environment, "Development",
StringComparison.OrdinalIgnoreCase)
        && EnableDebugStatePanelInDevelopment;
    private string SessionDebugJson => _sessionDebugJson;
    private string CatanStateDebugJson => _catanStateDebugJson;

    private bool PodeRolarDados => !_carregando
        && !TemSelecaoRecursoCartaDesenvolvimento
        && _session?.AvailableActions.Contains(GameActionTypes.RollDice) == true;

    private bool PodePassarTurno => !_carregando
        && !TemSelecaoRecursoCartaDesenvolvimento
        && _session?.AvailableActions.Contains(GameActionTypes.EndTurn) == true;

    private bool PodeComprarCartaDesenvolvimento => !_carregando
        && !TemSelecaoRecursoCartaDesenvolvimento
        && _session?.AvailableActions.Contains(GameActionTypes.BuyDevelopmentCard) == true;

    private bool PodeJogarCavaleiro => !_carregando
        && !TemSelecaoRecursoCartaDesenvolvimento
        && _session?.AvailableActions.Contains(GameActionTypes.PlayKnight) == true;

    private bool PodeJogarConstrutorEstradas => !_carregando
        && !TemSelecaoRecursoCartaDesenvolvimento
        && _session?.AvailableActions.Contains(GameActionTypes.PlayRoadBuilder) == true;

    private bool PodeJogarMaisDoisRecursos => !_carregando
        && !TemSelecaoRecursoCartaDesenvolvimento
        && _session?.AvailableActions.Contains(GameActionTypes.PlayPlus2Resources) == true;

    private bool PodeJogarMonopolio => !_carregando
        && !TemSelecaoRecursoCartaDesenvolvimento
        && _session?.AvailableActions.Contains(GameActionTypes.PlayMonopoly) == true;

    private bool TemSelecaoRecursoCartaDesenvolvimento => _developmentResourceSelectionCardType is not null;

    private int QuantidadeRecursosCartaDesenvolvimento =>
        string.Equals(_developmentResourceSelectionCardType, DevelopmentCardTypes.Plus2Resources,
StringComparison.OrdinalIgnoreCase)
            ? 2
            : 1;

    private bool PodeInteragirComRecursos => _session is not null
        && !_carregando
        && !TemSelecaoRecursoCartaDesenvolvimento
        && !TemDescartePendente
        && !TemResolucaoLadraoPendente
        && _session.Phase == GameTipoFase.Turno
        && _session.CanCurrentUserAct
        && _session.CatanState is not null
        && _session.CatanState.HasRolledDiceThisTurn;

    private bool PodeInteragirComMao => _session is not null
        && !_carregando
        && (TemDescartePendente || PodeInteragirComRecursos);

    private bool TemDescartePendente
    {
        get
        {
            if (_session?.CatanState?.PendingDiscardByPlayerId is null)
            {
                return false;
            }

            return _session.CatanState.PendingDiscardByPlayerId.TryGetValue(_session.YourPlayerId, out var amount)
                && amount > 0;
        }
    }

    private int QuantidadeDescartePendente
    {
        get
        {
            if (_session?.CatanState?.PendingDiscardByPlayerId is null)
            {
                return 0;
            }

            return _session.CatanState.PendingDiscardByPlayerId.TryGetValue(_session.YourPlayerId, out var amount)
                ? Math.Max(0, amount)
                : 0;
        }
    }

    private int QuantidadeDescarteSelecionada => _selectedDiscardResources.Values.Sum();

    private bool AguardandoPosicionamentoLadrao => _session?.AvailableActions.Contains(GameActionTypes.MoveRobber) == true;

    private bool AguardandoEscolhaVitimaLadrao => _session?.AvailableActions.Contains(GameActionTypes.ChooseRobberVictim) ==
true;

    private bool TemResolucaoLadraoPendente => AguardandoPosicionamentoLadrao || AguardandoEscolhaVitimaLadrao;

    private IReadOnlyDictionary<string, int> RecursosSelecionadosNaMao =>
        TemDescartePendente
            ? _selectedDiscardResources
            : _selectedTradeResources;

    private IReadOnlyList<GamePlayerStateResponse> VitimasElegiveisDoLadrao =>
        _session?.CatanState?.PendingRobberVictimPlayerIds is { Count: > 0 } victimIds
            ? _session.Players.Where(player => victimIds.Contains(player.UsuarioId)).ToList()
            : [];

    private IReadOnlyList<TradeOfferResponse> OfertasAtivas => _session?.CatanState?.ActiveTradeOffers
        .Where(offer => offer.ExpiresAtUtc > DateTime.UtcNow)
        .ToList() ?? [];

    private IReadOnlySet<int>? HighlightedVertexIds =>
        _session?.CatanState is { } vertexState
            ? _buildMode switch
            {
                GameActionTypes.BuildVillage => ComputeVillageTargets(vertexState, _session.YourPlayerId),
                GameActionTypes.BuildCity => ComputeCityTargets(vertexState, _session.YourPlayerId),
                _ => null
            }
            : null;

    private IReadOnlySet<EdgeKey>? HighlightedEdgeKeys =>
        _buildMode == GameActionTypes.BuildRoad && _session?.CatanState is { } edgeState
            ? ComputeRoadTargets(edgeState, _session.YourPlayerId)
            : null;

    private IReadOnlySet<int>? HighlightedTileIds =>
        AguardandoPosicionamentoLadrao && _session?.CatanState is { } tileState
            ? tileState.Tiles
                .Where(tile => tile.TileId != tileState.RobberTileId)
                .Select(tile => tile.TileId)
                .ToHashSet()
            : null;

    protected override async Task OnInitializedAsync()
    {
        HabilitarPollingRapidoTemporario();
        await AtualizarSessaoAsync();

        await InicializarAtualizacaoTempoRealAsync();

        _pollingCancellation = new CancellationTokenSource();
        _pollingTask = IniciarPollingAsync(_pollingCancellation.Token);
        _offerExpiryTask = AtualizarExpiracaoOfertasAsync(_pollingCancellation.Token);
    }

    private async Task AtualizarSessaoAsync()
    {
        _erro = null;
        _carregando = true;

        var result = await AuthService.ObterSessaoJogoAsync(SalaId);

        _carregando = false;

        if (!result.Success || result.Data is null)
        {
            _erro = result.ErrorMessage;
            return;
        }

        AtualizarSessionState(result.Data);
        HabilitarPollingRapidoTemporario();
    }

    private async Task AbrirOuAdicionarRecursoNaTrocaAsync(string resourceType)
    {
        if (!PodeInteragirComRecursos || _session is null)
        {
            return;
        }

        if (_askedTradeResources.ContainsKey(resourceType))
        {
            return;
        }

        var currentPlayer = _session.Players.FirstOrDefault(player => player.UsuarioId == _session.YourPlayerId);
        if (currentPlayer is null)
        {
            return;
        }

        var availableCount = currentPlayer.Resources.TryGetValue(resourceType, out var currentCount) ? currentCount : 0;
        var selectedCount = _selectedTradeResources.TryGetValue(resourceType, out var existingSelected) ? existingSelected : 0;

        if (selectedCount >= availableCount)
        {
            return;
        }

        _isTradeOpen = true;
        _selectedTradeResources[resourceType] = selectedCount + 1;
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleCliqueRecursoDaMaoAsync(string resourceType)
    {
        if (TemDescartePendente)
        {
            await AbrirOuAdicionarRecursoNoDescarteAsync(resourceType);
            return;
        }

        await AbrirOuAdicionarRecursoNaTrocaAsync(resourceType);
    }

    private async Task AbrirOuAdicionarRecursoNoDescarteAsync(string resourceType)
    {
        if (!TemDescartePendente || _session is null || _carregando)
        {
            return;
        }

        var requiredAmount = QuantidadeDescartePendente;
        if (requiredAmount <= 0 || QuantidadeDescarteSelecionada >= requiredAmount)
        {
            return;
        }

        var currentPlayer = _session.Players.FirstOrDefault(player => player.UsuarioId == _session.YourPlayerId);
        if (currentPlayer is null)
        {
            return;
        }

        var availableCount = currentPlayer.Resources.TryGetValue(resourceType, out var currentCount) ? currentCount : 0;
        var selectedCount = _selectedDiscardResources.TryGetValue(resourceType, out var existingSelected) ? existingSelected :
0;

        if (selectedCount >= availableCount)
        {
            return;
        }

        _selectedDiscardResources[resourceType] = selectedCount + 1;
        await InvokeAsync(StateHasChanged);
    }

    private async Task RemoverRecursoDoDescarteAsync(string resourceType)
    {
        if (string.IsNullOrWhiteSpace(resourceType))
        {
            return;
        }

        if (!_selectedDiscardResources.TryGetValue(resourceType, out var selectedCount) || selectedCount <= 0)
        {
            return;
        }

        if (selectedCount == 1)
        {
            _selectedDiscardResources.Remove(resourceType);
        }
        else
        {
            _selectedDiscardResources[resourceType] = selectedCount - 1;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task ExecutarDescarteAsync()
    {
        if (!TemDescartePendente || _session is null || _carregando)
        {
            return;
        }

        if (QuantidadeDescarteSelecionada != QuantidadeDescartePendente)
        {
            return;
        }

        _acaoErro = null;
        _carregando = true;

        var result = await AuthService.ExecutarAcaoJogoAsync(SalaId, new GameActionRequest
        {
            ActionType = GameActionTypes.DiscardResources,
            OfferedResources = new Dictionary<string, int>(_selectedDiscardResources, StringComparer.OrdinalIgnoreCase)
        });

        _carregando = false;

        if (!result.Success || result.Data is null)
        {
            _acaoErro = result.ErrorMessage ?? "Não foi possível descartar os recursos.";
            HabilitarPollingRapidoTemporario();
            await AtualizarSessaoEmSegundoPlanoAsync();
            return;
        }

        AtualizarSessionState(result.Data);
        HabilitarPollingRapidoTemporario();
    }

    private Task SelecionarVitimaDoLadraoAsync(int playerId)
    {
        _selectedRobberVictimPlayerId = playerId;
        return InvokeAsync(StateHasChanged);
    }

    private async Task ExecutarEscolhaVitimaLadraoAsync()
    {
        if (!AguardandoEscolhaVitimaLadrao || _session is null || _carregando || _selectedRobberVictimPlayerId is null)
        {
            return;
        }

        _acaoErro = null;
        _carregando = true;

        var result = await AuthService.ExecutarAcaoJogoAsync(SalaId, new GameActionRequest
        {
            ActionType = GameActionTypes.ChooseRobberVictim,
            TargetPlayerId = _selectedRobberVictimPlayerId
        });

        _carregando = false;

        if (!result.Success || result.Data is null)
        {
            _acaoErro = result.ErrorMessage ?? "Não foi possível concluir o roubo do ladrão.";
            HabilitarPollingRapidoTemporario();
            await AtualizarSessaoEmSegundoPlanoAsync();
            return;
        }

        AtualizarSessionState(result.Data);
        HabilitarPollingRapidoTemporario();
    }

    private async Task FecharInterfaceTrocaAsync()
    {
        _isTradeOpen = false;
        _selectedTradeResources.Clear();
        _askedTradeResources.Clear();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RemoverRecursoDaTrocaAsync(string resourceType)
    {
        if (string.IsNullOrWhiteSpace(resourceType))
        {
            return;
        }

        if (!_selectedTradeResources.TryGetValue(resourceType, out var selectedCount) || selectedCount <= 0)
        {
            return;
        }

        if (selectedCount == 1)
        {
            _selectedTradeResources.Remove(resourceType);
        }
        else
        {
            _selectedTradeResources[resourceType] = selectedCount - 1;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task ExecutarOfertaTrocaAsync()
    {
        if (!PodeInteragirComRecursos || _session is null || _carregando
            || _selectedTradeResources.Count == 0 || _askedTradeResources.Count == 0)
        {
            return;
        }

        _acaoErro = null;
        _carregando = true;

        var result = await AuthService.ExecutarAcaoJogoAsync(SalaId, new GameActionRequest
        {
            ActionType = GameActionTypes.OfferTrade,
            OfferedResources = new Dictionary<string, int>(_selectedTradeResources, StringComparer.OrdinalIgnoreCase),
            AskedResources = new Dictionary<string, int>(_askedTradeResources, StringComparer.OrdinalIgnoreCase)
        });

        _carregando = false;

        if (!result.Success || result.Data is null)
        {
            _acaoErro = result.ErrorMessage ?? "Não foi possível oferecer a troca.";
            return;
        }

        AtualizarSessionState(result.Data);
        await FecharInterfaceTrocaAsync();
        HabilitarPollingRapidoTemporario();
    }

    private Task ExecutarAceiteOfertaTrocaAsync(long offerId)
    {
        return ExecutarRespostaOfertaTrocaAsync(offerId, GameActionTypes.AcceptTrade, "Não foi possível aceitar a troca.");
    }

    private Task ExecutarRecusaOfertaTrocaAsync(long offerId)
    {
        return ExecutarRespostaOfertaTrocaAsync(offerId, GameActionTypes.DeclineTrade, "Não foi possível recusar a troca.");
    }

    private async Task ExecutarTrocaEntreJogadoresAsync(TradeOfferExecutionSelection selection)
    {
        if (_session is null || _carregando)
        {
            return;
        }

        _acaoErro = null;
        _carregando = true;

        var result = await AuthService.ExecutarAcaoJogoAsync(SalaId, new GameActionRequest
        {
            ActionType = GameActionTypes.ExecuteTrade,
            OfferId = selection.OfferId,
            TargetPlayerId = selection.TargetPlayerId
        });

        _carregando = false;

        if (!result.Success || result.Data is null)
        {
            _acaoErro = result.ErrorMessage ?? "Não foi possível concluir a troca.";
            HabilitarPollingRapidoTemporario();
            await AtualizarSessaoEmSegundoPlanoAsync();
            return;
        }

        AtualizarSessionState(result.Data);
        HabilitarPollingRapidoTemporario();
    }

    private async Task ExecutarRespostaOfertaTrocaAsync(long offerId, string actionType, string errorMessage)
    {
        if (_session is null || _carregando)
        {
            return;
        }

        _acaoErro = null;
        _carregando = true;

        var result = await AuthService.ExecutarAcaoJogoAsync(SalaId, new GameActionRequest
        {
            ActionType = actionType,
            OfferId = offerId
        });

        _carregando = false;

        if (!result.Success || result.Data is null)
        {
            _acaoErro = result.ErrorMessage ?? errorMessage;
            HabilitarPollingRapidoTemporario();
            await AtualizarSessaoEmSegundoPlanoAsync();
            return;
        }

        AtualizarSessionState(result.Data);
        HabilitarPollingRapidoTemporario();
    }

    private async Task ExecutarTrocaBancoAsync()
    {
        if (!PodeInteragirComRecursos || _session is null || _carregando
            || _selectedTradeResources.Count == 0 || _askedTradeResources.Count == 0)
        {
            return;
        }

        _acaoErro = null;
        _carregando = true;

        var result = await AuthService.ExecutarAcaoJogoAsync(SalaId, new GameActionRequest
        {
            ActionType = GameActionTypes.TradeWithBank,
            OfferedResources = new Dictionary<string, int>(_selectedTradeResources, StringComparer.OrdinalIgnoreCase),
