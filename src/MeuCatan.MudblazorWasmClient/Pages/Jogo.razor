    private static HashSet<EdgeKey> ComputeRoadTargets(CatanGameStateResponse state, int playerId)
    {
        var vertexOwner = state.Vertices.ToDictionary(v => v.VertexId, v => v.OwnerPlayerId);

        var edgesByVertex = new Dictionary<int, List<EdgeKey>>();
        foreach (var edge in state.Edges)
        {
            var key = new EdgeKey(edge.smallerVertexId, edge.biggerVertexId);
            if (!edgesByVertex.TryGetValue(edge.smallerVertexId, out var l1))
                edgesByVertex[edge.smallerVertexId] = l1 = [];
            l1.Add(key);
            if (!edgesByVertex.TryGetValue(edge.biggerVertexId, out var l2))
                edgesByVertex[edge.biggerVertexId] = l2 = [];
            l2.Add(key);
        }

        var playerEdges = state.Edges
            .Where(e => e.OwnerPlayerId == playerId)
            .Select(e => new EdgeKey(e.smallerVertexId, e.biggerVertexId))
            .ToHashSet();

        var result = new HashSet<EdgeKey>();
        foreach (var edge in state.Edges.Where(e => e.OwnerPlayerId is null))
        {
            var key = new EdgeKey(edge.smallerVertexId, edge.biggerVertexId);
            if (IsReachableEndpoint(edge.smallerVertexId, key, playerId, vertexOwner, edgesByVertex, playerEdges) ||
                IsReachableEndpoint(edge.biggerVertexId, key, playerId, vertexOwner, edgesByVertex, playerEdges))
                result.Add(key);
        }
        return result;
    }

    private static bool IsReachableEndpoint(
        int vertexId,
        EdgeKey targetEdge,
        int playerId,
        Dictionary<int, int?> vertexOwner,
        Dictionary<int, List<EdgeKey>> edgesByVertex,
        HashSet<EdgeKey> playerEdges)
    {
        if (!vertexOwner.TryGetValue(vertexId, out var owner))
            return false;
        if (owner == playerId)
            return true;
        if (owner is not null)
            return false;
        if (!edgesByVertex.TryGetValue(vertexId, out var adjacent))
            return false;
        return adjacent.Any(e => e != targetEdge && playerEdges.Contains(e));
    }

    private static HashSet<int> ComputeVillageTargets(CatanGameStateResponse state, int playerId)
    {
        var roadEndpoints = state.Edges
            .Where(e => e.OwnerPlayerId == playerId)
            .SelectMany(e => new[] { e.smallerVertexId, e.biggerVertexId })
            .ToHashSet();

        var occupied = state.Vertices
            .Where(v => v.OwnerPlayerId is not null)
            .Select(v => v.VertexId)
            .ToHashSet();

        var adjacentVertices = new Dictionary<int, List<int>>();
        foreach (var edge in state.Edges)
        {
            if (!adjacentVertices.TryGetValue(edge.smallerVertexId, out var la))
                adjacentVertices[edge.smallerVertexId] = la = [];
            la.Add(edge.biggerVertexId);
            if (!adjacentVertices.TryGetValue(edge.biggerVertexId, out var lb))
                adjacentVertices[edge.biggerVertexId] = lb = [];
            lb.Add(edge.smallerVertexId);
        }

        var result = new HashSet<int>();
        foreach (var vertex in state.Vertices.Where(v => v.OwnerPlayerId is null))
        {
            if (!roadEndpoints.Contains(vertex.VertexId))
                continue;
            if (adjacentVertices.TryGetValue(vertex.VertexId, out var neighbors) && neighbors.Any(n => occupied.Contains(n)))
                continue;
            result.Add(vertex.VertexId);
        }
        return result;
    }

    private static HashSet<int> ComputeCityTargets(CatanGameStateResponse state, int playerId)
        => state.Vertices
            .Where(v => v.OwnerPlayerId == playerId
                && string.Equals(v.BuildingType, "aldeia", StringComparison.OrdinalIgnoreCase))
            .Select(v => v.VertexId)
            .ToHashSet();
}
