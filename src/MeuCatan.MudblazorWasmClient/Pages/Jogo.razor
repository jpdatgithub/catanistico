    private static bool ExcedeRecursosDisponiveisNoDescarte(
        GamePlayerStateResponse player,
        IReadOnlyDictionary<string, int> selectedDiscardResources)
    {
        foreach (var selected in selectedDiscardResources)
        {
            if (selected.Value <= 0)
            {
                return true;
            }

            if (player.Resources.GetValueOrDefault(selected.Key) < selected.Value)
            {
                return true;
            }
        }

        return false;
    }

