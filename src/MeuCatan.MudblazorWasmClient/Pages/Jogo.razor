    private void AtualizarSessionState(GameSessionResponse session)
    {
        if (_buildMode is not null)
        {
            var isInteractable = session.Phase == GameTipoFase.Turno
                && session.CanCurrentUserAct
                && (session.CatanState?.HasRolledDiceThisTurn == true
                    || session.CatanState?.PendingRoadBuilderRoads > 0)
                && !session.AvailableActions.Contains(GameActionTypes.MoveRobber)
                && !session.AvailableActions.Contains(GameActionTypes.ChooseRobberVictim)
                && !(session.CatanState?.PendingDiscardByPlayerId.TryGetValue(session.YourPlayerId, out var pendingDiscardForBuildMode)
== true
                    && pendingDiscardForBuildMode > 0);
            if (!isInteractable)
                _buildMode = null;
        }

        _session = session;

        if (_developmentResourceSelectionCardType is not null)
        {
            var pendingActionType = string.Equals(_developmentResourceSelectionCardType,
                DevelopmentCardTypes.Plus2Resources, StringComparison.OrdinalIgnoreCase)
                ? GameActionTypes.PlayPlus2Resources
                : GameActionTypes.PlayMonopoly;

            if (!session.AvailableActions.Contains(pendingActionType))
            {
                _developmentResourceSelectionCardType = null;
                _selectedDevelopmentCardResources.Clear();
            }
        }

        if (session.CatanState?.PendingRoadBuilderRoads > 0
            && session.AvailableActions.Contains(GameActionTypes.BuildRoad))
        {
            _buildMode = GameActionTypes.BuildRoad;
        }

        if (_session.AvailableActions.Contains(GameActionTypes.ChooseRobberVictim))
        {
            if (_selectedRobberVictimPlayerId is not null
                && !_session.CatanState!.PendingRobberVictimPlayerIds.Contains(_selectedRobberVictimPlayerId.Value))
            {
                _selectedRobberVictimPlayerId = null;
            }
        }
        else
        {
            _selectedRobberVictimPlayerId = null;
        }

        var pendingDiscardAmount = session.CatanState?.PendingDiscardByPlayerId.TryGetValue(session.YourPlayerId, out var
amount) == true
            ? Math.Max(0, amount)
            : 0;

        if (pendingDiscardAmount > 0)
        {
            _isTradeOpen = false;
            _selectedTradeResources.Clear();
            _askedTradeResources.Clear();

            var currentPlayer = session.Players.FirstOrDefault(player => player.UsuarioId == session.YourPlayerId);
            if (currentPlayer is null
                || QuantidadeDescarteSelecionada > pendingDiscardAmount
                || ExcedeRecursosDisponiveisNoDescarte(currentPlayer, _selectedDiscardResources))
            {
                _selectedDiscardResources.Clear();
            }
        }
        else
        {
            _selectedDiscardResources.Clear();
        }

        if (TemResolucaoLadraoPendente)
        {
            _isTradeOpen = false;
            _selectedTradeResources.Clear();
            _askedTradeResources.Clear();
        }

        if (!_isTradeOpen)
        {
            _selectedTradeResources.Clear();
            _askedTradeResources.Clear();
        }

        if (DebugStatePanelEnabled)
        {
            _sessionDebugJson = SerializarDebug(session);
            _catanStateDebugJson = SerializarDebug(session.CatanState);
        }
    }

