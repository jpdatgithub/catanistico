@page "/jogo/{SalaId:int}"
@implements IAsyncDisposable

@inject ClienteAuthService AuthService
@inject HttpClient Http
@inject Microsoft.AspNetCore.Components.WebAssembly.Hosting.IWebAssemblyHostEnvironment HostEnvironment
@using MeuCatan.MudblazorWasmClient.Components.Catan
@using System.Text.Json

<PageTitle>Jogo</PageTitle>

<div class="game-page-shell">
    <MudContainer MaxWidth="MaxWidth.False" Class="game-page px-4">
        @if (_carregando && _session is null)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        }
        else if (_session is null)
        {
            <MudAlert Severity="Severity.Error">@(_erro ?? "Sessão de jogo não encontrada.")</MudAlert>
        }
        else
        {
            var currentPlayer = _session.Players.FirstOrDefault(player => player.UsuarioId == _session.YourPlayerId);

            <MudGrid Class="game-layout">
                <MudItem xs="12" md="8" Class="game-board-column">
                    <MudPaper Class="game-board-surface pa-4">
                        @* <MudText Typo="Typo.h5" Class="mb-2">Tabuleiro de Catan</MudText>
                        <MudText Typo="Typo.body2" Class="mb-4">
                            Este primeiro corte já carrega uma sessão real e um board SVG do Catan. As ações interativas de
                            colocação inicial entram no próximo passo.
                        </MudText>

                        <MudText Typo="Typo.body2" Class="mb-2">
                            Quando o setup estiver no seu turno, clique no destaque verde para executar sua ação: vértice para
                            aldeia e aresta para estrada.
                        </MudText> *@

                        <div class="game-board-viewport">
                            @if (_session.CatanState is not null)
                            {
                                <CatanBoardSvg State="_session.CatanState" FillParent="true"
                                               PlayerColorsById="@_session.Players.ToDictionary(player => player.UsuarioId, player => player.Cor)"
                                               OnVertexClicked="ExecutarPosicionamentoInicialAsync"
                                               OnEdgeClicked="ExecutarPosicionamentoEstradaInicialAsync" />
                            }

                            @if (currentPlayer is not null && _isTradeOpen)
                            {
                                <ResourceTradePanel Player="currentPlayer" IsOpen="true"
                                                    OfferedResources="_selectedTradeResources" AskedResources="_askedTradeResources"
                                                    OnClose="FecharInterfaceTrocaAsync" OnSelectedResourceClicked="RemoverRecursoDaTrocaAsync"
                                                    OnOffer="ExecutarOfertaTrocaAsync" />
                            }

                            <OfferViewPanelStack Offers="OfertasAtivas" ViewerColor="@currentPlayer?.Cor" />
                        </div>

                        @if (currentPlayer is not null)
                        {
                            <div class="game-resource-bar">
                                <PlayerResourcePanel Player="currentPlayer" SelectedResources="_selectedTradeResources"
                                                     CanInteract="@PodeInteragirComRecursos"
                                                     OnResourceClicked="AbrirOuAdicionarRecursoNaTrocaAsync" />
                            </div>
                        }
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="4" Class="game-sidebar-column">
                    <MudStack Spacing="2" Class="game-sidebar-content">
                        @* <MudPaper Class="pa-4">
                            <MudText Typo="Typo.h6">Sessão</MudText>
                            <MudText Typo="Typo.body2">Sala: @_session.SalaId</MudText>
                            <MudText Typo="Typo.body2">Jogo: @_session.GameType</MudText>
                            <MudText Typo="Typo.body2">Fase: @FormatarFase(_session.Phase)</MudText>
                            <MudText Typo="Typo.body2">Turno atual: @_session.CurrentPlayerNome</MudText>
                            <MudText Typo="Typo.body2">Você pode agir: @(_session.CanCurrentUserAct ? "sim" : "não")
                            </MudText>
                        </MudPaper> *@

                        <MudPaper Class="pa-4">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.h6">Jogadores</MudText>
                                <MudButton Variant="Variant.Text" OnClick="AtualizarSessaoAsync" Disabled="@_carregando">
                                    Atualizar
                                </MudButton>
                            </MudStack>
                            <MudList T="GamePlayerStateResponse">
                                @foreach (var player in _session.Players)
                                {
                                    <MudListItem T="GamePlayerStateResponse" Value="player">
                                        <MudStack Spacing="0" Class="w-100">
                                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                                <MudText>@player.Nome</MudText>
                                                <MudChip Size="Size.Small"
                                                         Color="@(player.IsCurrentTurn ? Color.Primary : Color.Default)">@player.Cor
                                                </MudChip>
                                            </MudStack>
                                            <MudText Typo="Typo.caption">Pontos: @player.Pontos</MudText>
                                            <MudText Typo="Typo.caption">Peças: estradas @player.RemainingRoads, aldeias
                                                @player.RemainingSettlements, cidades @player.RemainingCities</MudText>
                                            </MudStack>
                                        </MudListItem>
                                    }
                                </MudList>
                            </MudPaper>

                            <GameChatPanel SalaId="@SalaId" />
                            @if (_session.Phase == GameTipoFase.Turno && _session.CatanState is not null)
                            {
                                <MudPaper Class="pa-4">
                                    <MudText Typo="Typo.h6">Turno</MudText>

                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2"
                                               Disabled="@(!PodeRolarDados)" OnClick="ExecutarRolagemDadosAsync">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            <DiceFace Value="@(_session.CatanState.LastDice1 ?? 6)" Size="36" />
                                            <DiceFace Value="@(_session.CatanState.LastDice2 ?? 6)" Size="36" />
                                            <MudText Typo="Typo.button" Class="ml-1">Rolar dados</MudText>
                                        </MudStack>
                                    </MudButton>

                                    @if (_session.CatanState.LastDiceTotal is not null)
                                    {
                                        <MudText Typo="Typo.body1" Class="mt-2">
                                            Último resultado: @_session.CatanState.LastDice1 + @_session.CatanState.LastDice2 =
                                            <b>@_session.CatanState.LastDiceTotal</b>
                                        </MudText>

                                        @if (_session.CatanState.HasRolledDiceThisTurn)
                                        {
                                            @if (_session.CatanState.LastDiceTotal == 7)
                                            {
                                                <MudText Typo="Typo.body2">Saiu 7: ninguém recebe recursos.</MudText>
                                            }
                                            else if (_session.CatanState.LastRollResourceGains.Count == 0)
                                            {
                                                <MudText Typo="Typo.body2">Nenhum jogador produziu recursos nesta rolagem.</MudText>
                                            }
                                            else
                                            {
                                                @foreach (var gain in _session.CatanState.LastRollResourceGains)
                                                {
                                                    <MudText Typo="Typo.body2">@gain.PlayerNome recebeu +@gain.Amount @gain.ResourceType</MudText>
                                                }
                                            }
                                        }
                                    }

                                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Class="mt-3"
                                               Disabled="@(!PodePassarTurno)" OnClick="ExecutarPassarTurnoAsync">
                                        Passar turno
                                    </MudButton>
                                </MudPaper>
                            }

                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="@($"/sala/{SalaId}")">
                                Voltar para a sala
                            </MudButton>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            }
        </MudContainer>
    </div>

@code {
    [Parameter]
    public int SalaId { get; set; }

    private GameSessionResponse? _session;
    private string? _erro;
    private string? _acaoErro;
    private bool _carregando;
    private CancellationTokenSource? _pollingCancellation;
    private Task? _pollingTask;
    private Task? _offerExpiryTask;
    private HubConnection? _stateHubConnection;
    private DateTime _pollingRapidoAteUtc;
    private string _sessionDebugJson = "null";
    private string _catanStateDebugJson = "null";
    private bool _isTradeOpen;
    private readonly Dictionary<string, int> _selectedTradeResources = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, int> _askedTradeResources = new(StringComparer.OrdinalIgnoreCase);
    // Keep heavy state serialization opt-in even in development builds.
    private const bool EnableDebugStatePanelInDevelopment = false;
    private const int PollingNormalMs = 2000;
    private const int PollingRapidoMs = 600;
    private static readonly TimeSpan JanelaPollingRapido = TimeSpan.FromSeconds(6);
    private static readonly JsonSerializerOptions _jsonDebugOptions = new()
    {
        WriteIndented = true
    };

    private bool DebugStatePanelEnabled => string.Equals(HostEnvironment.Environment, "Development",
StringComparison.OrdinalIgnoreCase)
        && EnableDebugStatePanelInDevelopment;
    private string SessionDebugJson => _sessionDebugJson;
    private string CatanStateDebugJson => _catanStateDebugJson;

    private bool PodeRolarDados => !_carregando
        && _session?.AvailableActions.Contains(GameActionTypes.RollDice) == true;

    private bool PodePassarTurno => !_carregando
        && _session?.AvailableActions.Contains(GameActionTypes.EndTurn) == true;

    private bool PodeInteragirComRecursos => _session is not null
        && !_carregando
        && _session.Phase == GameTipoFase.Turno
        && _session.CanCurrentUserAct
        && _session.CatanState is not null
        && _session.CatanState.HasRolledDiceThisTurn;

    private IReadOnlyList<TradeOfferResponse> OfertasAtivas => _session?.CatanState?.ActiveTradeOffers
        .Where(offer => offer.ExpiresAtUtc > DateTime.UtcNow)
        .ToList() ?? [];

    protected override async Task OnInitializedAsync()
    {
        HabilitarPollingRapidoTemporario();
        await AtualizarSessaoAsync();

        await InicializarAtualizacaoTempoRealAsync();

        _pollingCancellation = new CancellationTokenSource();
        _pollingTask = IniciarPollingAsync(_pollingCancellation.Token);
        _offerExpiryTask = AtualizarExpiracaoOfertasAsync(_pollingCancellation.Token);
    }

    private async Task AtualizarSessaoAsync()
    {
        _erro = null;
        _carregando = true;

        var result = await AuthService.ObterSessaoJogoAsync(SalaId);

        _carregando = false;

        if (!result.Success || result.Data is null)
        {
            _erro = result.ErrorMessage;
            return;
        }

        AtualizarSessionState(result.Data);
        HabilitarPollingRapidoTemporario();
    }

    private async Task AbrirOuAdicionarRecursoNaTrocaAsync(string resourceType)
    {
        if (!PodeInteragirComRecursos || _session is null)
        {
            return;
        }

        if (_askedTradeResources.ContainsKey(resourceType))
        {
            return;
        }

        var currentPlayer = _session.Players.FirstOrDefault(player => player.UsuarioId == _session.YourPlayerId);
        if (currentPlayer is null)
        {
            return;
        }

        var availableCount = currentPlayer.Resources.TryGetValue(resourceType, out var currentCount) ? currentCount : 0;
        var selectedCount = _selectedTradeResources.TryGetValue(resourceType, out var existingSelected) ? existingSelected : 0;

        if (selectedCount >= availableCount)
        {
            return;
        }

        _isTradeOpen = true;
        _selectedTradeResources[resourceType] = selectedCount + 1;
        await InvokeAsync(StateHasChanged);
    }

    private async Task FecharInterfaceTrocaAsync()
    {
        _isTradeOpen = false;
        _selectedTradeResources.Clear();
        _askedTradeResources.Clear();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RemoverRecursoDaTrocaAsync(string resourceType)
    {
        if (string.IsNullOrWhiteSpace(resourceType))
        {
            return;
        }

        if (!_selectedTradeResources.TryGetValue(resourceType, out var selectedCount) || selectedCount <= 0)
        {
            return;
        }

        if (selectedCount == 1)
        {
            _selectedTradeResources.Remove(resourceType);
        }
        else
        {
            _selectedTradeResources[resourceType] = selectedCount - 1;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task ExecutarOfertaTrocaAsync()
    {
        if (!PodeInteragirComRecursos || _session is null || _carregando
            || _selectedTradeResources.Count == 0 || _askedTradeResources.Count == 0)
        {
            return;
        }

        _acaoErro = null;
        _carregando = true;

        var result = await AuthService.ExecutarAcaoJogoAsync(SalaId, new GameActionRequest
        {
            ActionType = GameActionTypes.OfferTrade,
            OfferedResources = new Dictionary<string, int>(_selectedTradeResources, StringComparer.OrdinalIgnoreCase),
            AskedResources = new Dictionary<string, int>(_askedTradeResources, StringComparer.OrdinalIgnoreCase)
        });

        _carregando = false;

        if (!result.Success || result.Data is null)
        {
            _acaoErro = result.ErrorMessage ?? "Não foi possível oferecer a troca.";
            return;
        }

        AtualizarSessionState(result.Data);
        await FecharInterfaceTrocaAsync();
        HabilitarPollingRapidoTemporario();
    }

    private async Task ExecutarPosicionamentoInicialAsync(int vertexId)
    {
        if (_session is null || _carregando)
        {
            return;
        }

        _acaoErro = null;
        _carregando = true;

        var result = await AuthService.ExecutarAcaoJogoAsync(SalaId, new GameActionRequest
        {
            ActionType = GameActionTypes.PlaceInitialSettlement,
            VertexId = vertexId
        });

        _carregando = false;

        if (!result.Success || result.Data is null)
        {
            _acaoErro = result.ErrorMessage ?? "Não foi possível posicionar a aldeia.";
            return;
        }

        AtualizarSessionState(result.Data);
        HabilitarPollingRapidoTemporario();
    }

    private async Task ExecutarPosicionamentoEstradaInicialAsync(EdgeKey edge)
    {
        if (_session is null || _carregando)
        {
            return;
        }

        _acaoErro = null;
        _carregando = true;

        var result = await AuthService.ExecutarAcaoJogoAsync(SalaId, new GameActionRequest
        {
            ActionType = GameActionTypes.PlaceInitialRoad,
            SmallerVertexId = edge.smallerVertexId,
            BiggerVertexId = edge.biggerVertexId
        });

        _carregando = false;

        if (!result.Success || result.Data is null)
        {
            _acaoErro = result.ErrorMessage ?? "Não foi possível posicionar a estrada inicial.";
            return;
        }

        AtualizarSessionState(result.Data);
    }

    private async Task ExecutarRolagemDadosAsync()
    {
        await ExecutarAcaoDeTurnoAsync(GameActionTypes.RollDice, "Não foi possível rolar os dados.");
    }

    private async Task ExecutarPassarTurnoAsync()
    {
        await ExecutarAcaoDeTurnoAsync(GameActionTypes.EndTurn, "Não foi possível passar o turno.");
    }

    private async Task ExecutarAcaoDeTurnoAsync(string actionType, string mensagemErroPadrao)
    {
        if (_session is null || _carregando)
        {
            return;
        }

        _acaoErro = null;
        _carregando = true;

        var result = await AuthService.ExecutarAcaoJogoAsync(SalaId, new GameActionRequest
        {
            ActionType = actionType
        });

        _carregando = false;

        if (!result.Success || result.Data is null)
        {
            _acaoErro = result.ErrorMessage ?? mensagemErroPadrao;
            return;
        }

        AtualizarSessionState(result.Data);
        HabilitarPollingRapidoTemporario();
    }

    private async Task IniciarPollingAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                var intervalo = DateTime.UtcNow < _pollingRapidoAteUtc
                    ? PollingRapidoMs
                    : PollingNormalMs;

                await Task.Delay(intervalo, cancellationToken);

                var result = await AuthService.ObterSessaoJogoAsync(SalaId);
                if (result.Success && result.Data is not null)
                {
                    AtualizarSessionState(result.Data);
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task AtualizarExpiracaoOfertasAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task InicializarAtualizacaoTempoRealAsync()
    {
        var token = await AuthService.EnsureSessionAsync();
        if (string.IsNullOrWhiteSpace(token))
        {
            return;
        }

        var hubUri = new Uri(Http.BaseAddress!, "hubs/game-chat");

        _stateHubConnection = new HubConnectionBuilder()
            .WithUrl(hubUri, options =>
            {
                options.AccessTokenProvider = AuthService.EnsureSessionAsync;
            })
            .WithAutomaticReconnect()
            .Build();

        _stateHubConnection.On<int, string, DateTime>("ReceiveGameStateInvalidation", (salaId, _, _) =>
        {
            if (salaId != SalaId)
            {
                return Task.CompletedTask;
            }

            HabilitarPollingRapidoTemporario();
            return InvokeAsync(AtualizarSessaoEmSegundoPlanoAsync);
        });

        try
        {
            await _stateHubConnection.StartAsync();
            await _stateHubConnection.InvokeAsync("JoinGameRoom", SalaId);
        }
        catch
        {
            // Polling remains as fallback when SignalR is unavailable.
        }
    }

    private async Task AtualizarSessaoEmSegundoPlanoAsync()
    {
        var result = await AuthService.ObterSessaoJogoAsync(SalaId);
        if (result.Success && result.Data is not null)
        {
            AtualizarSessionState(result.Data);
            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_pollingCancellation is not null)
        {
            await _pollingCancellation.CancelAsync();
            _pollingCancellation.Dispose();
        }

        if (_pollingTask is not null)
        {
            await _pollingTask;
        }

        if (_offerExpiryTask is not null)
        {
            await _offerExpiryTask;
        }

        if (_stateHubConnection is not null)
        {
            await _stateHubConnection.DisposeAsync();
        }
    }

    private static string FormatarFase(GameTipoFase phase)
    {
        return phase switch
        {
            GameTipoFase.SetupInicial => "Setup inicial",
            GameTipoFase.Turno => "Turno",
            GameTipoFase.Finalizado => "Finalizado",
            _ => phase.ToString()
        };
    }

    private static string SerializarDebug<T>(T? payload)
    {
        if (payload is null)
        {
            return "null";
        }

        return JsonSerializer.Serialize(payload, _jsonDebugOptions);
    }

    private void AtualizarSessionState(GameSessionResponse session)
    {
        _session = session;

        if (!_isTradeOpen)
        {
            _selectedTradeResources.Clear();
            _askedTradeResources.Clear();
        }

        if (DebugStatePanelEnabled)
        {
            _sessionDebugJson = SerializarDebug(session);
            _catanStateDebugJson = SerializarDebug(session.CatanState);
        }
    }

    private void HabilitarPollingRapidoTemporario()
    {
        _pollingRapidoAteUtc = DateTime.UtcNow.Add(JanelaPollingRapido);
    }
}
