    private async Task HandleCliqueCartaDesenvolvimentoAsync(string cardType)
    {
        if (string.Equals(cardType, DevelopmentCardTypes.Knight, StringComparison.OrdinalIgnoreCase))
        {
            if (!PodeJogarCavaleiro)
            {
                return;
            }

            await ExecutarAcaoDeTurnoAsync(
                GameActionTypes.PlayKnight,
                "Não foi possível jogar a carta Cavaleiro.");
            return;
        }

        if (string.Equals(cardType, DevelopmentCardTypes.Plus2Resources, StringComparison.OrdinalIgnoreCase))
        {
            if (!PodeJogarMaisDoisRecursos)
            {
                return;
            }

            await AbrirSelecaoRecursoCartaDesenvolvimentoAsync(DevelopmentCardTypes.Plus2Resources);
            return;
        }

        if (string.Equals(cardType, DevelopmentCardTypes.Monopoly, StringComparison.OrdinalIgnoreCase))
        {
            if (!PodeJogarMonopolio)
            {
                return;
            }

            await AbrirSelecaoRecursoCartaDesenvolvimentoAsync(DevelopmentCardTypes.Monopoly);
            return;
        }

        if (!string.Equals(cardType, DevelopmentCardTypes.RoadBuilder, StringComparison.OrdinalIgnoreCase)
            || !PodeJogarConstrutorEstradas)
        {
            return;
        }

        await ExecutarAcaoDeTurnoAsync(
            GameActionTypes.PlayRoadBuilder,
            "Não foi possível jogar a carta Construtor de Estradas.");
    }

    private Task AbrirSelecaoRecursoCartaDesenvolvimentoAsync(string cardType)
    {
        _developmentResourceSelectionCardType = cardType;
        _selectedDevelopmentCardResources.Clear();
        _isTradeOpen = false;
        _selectedTradeResources.Clear();
        _askedTradeResources.Clear();
        _buildMode = null;
        return InvokeAsync(StateHasChanged);
    }

    private Task AdicionarRecursoCartaDesenvolvimentoAsync(string resourceType)
    {
        if (!TemSelecaoRecursoCartaDesenvolvimento
            || _selectedDevelopmentCardResources.Values.Sum() >= QuantidadeRecursosCartaDesenvolvimento)
        {
            return Task.CompletedTask;
        }

        var selectedCount = _selectedDevelopmentCardResources.GetValueOrDefault(resourceType);
        if (string.Equals(_developmentResourceSelectionCardType, DevelopmentCardTypes.Plus2Resources,
                StringComparison.OrdinalIgnoreCase)
            && (_session?.CatanState?.Bank?.ResourceCounts.GetValueOrDefault(resourceType) ?? 0) <= selectedCount)
        {
            return Task.CompletedTask;
        }

        _selectedDevelopmentCardResources[resourceType] = selectedCount + 1;
        return InvokeAsync(StateHasChanged);
    }

    private Task RemoverRecursoCartaDesenvolvimentoAsync(string resourceType)
    {
        var selectedCount = _selectedDevelopmentCardResources.GetValueOrDefault(resourceType);
        if (selectedCount <= 0)
        {
            return Task.CompletedTask;
        }

        if (selectedCount == 1)
        {
            _selectedDevelopmentCardResources.Remove(resourceType);
        }
        else
        {
            _selectedDevelopmentCardResources[resourceType] = selectedCount - 1;
        }

        return InvokeAsync(StateHasChanged);
    }

