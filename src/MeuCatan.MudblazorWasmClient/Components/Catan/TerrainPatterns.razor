<defs>
    <pattern id="forestPattern" patternUnits="userSpaceOnUse" width="80" height="80">

        <!-- Fundo -->
        <rect width="80" height="80" fill="#3f7d3a" />

        <!-- manchas de vegetação -->
        <circle cx="15" cy="20" r="18" fill="#356b32" opacity="0.35" />
        <circle cx="65" cy="55" r="22" fill="#4c9145" opacity="0.35" />

        <!-- árvore 1 -->
        <g transform="translate(20,15)">
            <!-- tronco -->
            <rect x="9" y="32" width="6" height="15" rx="2" fill="#6b4226" />

            <!-- copa -->
            <circle cx="12" cy="20" r="13" fill="#245c2b" />
            <circle cx="5" cy="25" r="8" fill="#2f7435" />
            <circle cx="19" cy="25" r="8" fill="#2f7435" />
            <circle cx="12" cy="12" r="8" fill="#3d8b42" />
        </g>


        <!-- árvore 2 -->
        <g transform="translate(55,45) scale(0.7)">
            <rect x="9" y="32" width="6" height="15" rx="2" fill="#6b4226" />

            <circle cx="12" cy="20" r="13" fill="#245c2b" />
            <circle cx="5" cy="25" r="8" fill="#2f7435" />
            <circle cx="19" cy="25" r="8" fill="#2f7435" />
            <circle cx="12" cy="12" r="8" fill="#3d8b42" />
        </g>

        <!-- pequenos arbustos -->
        <circle cx="45" cy="18" r="4" fill="#235c2a" />
        <circle cx="70" cy="25" r="3" fill="#2c6d31" />
        <circle cx="35" cy="65" r="5" fill="#255f2b" />

    </pattern>
    <pattern id="clayPattern" patternUnits="userSpaceOnUse" width="80" height="80">

        <!-- Fundo de barro -->
        <rect width="80" height="80" fill="#b86b3d" />


        <!-- manchas de terra -->
        <circle cx="15" cy="20" r="20" fill="#a55a32" opacity="0.35" />

        <circle cx="65" cy="55" r="25" fill="#d1844b" opacity="0.35" />


        <!-- pequenas pedras -->
        <g fill="#7d4a2d" opacity="0.8">

            <ellipse cx="20" cy="60" rx="6" ry="3" transform="rotate(-20 20 60)" />

            <ellipse cx="55" cy="18" rx="5" ry="3" transform="rotate(25 55 18)" />

            <ellipse cx="70" cy="35" rx="4" ry="2" transform="rotate(-15 70 35)" />

        </g>


        <!-- rachaduras no barro -->
        <g stroke="#8c4b2b" stroke-width="1.5" fill="none" opacity="0.7">

            <path d="M8 45 L15 40 L12 34" />

            <path d="M45 70 L52 63 L60 65" />

            <path d="M35 10 L40 16 L37 22" />

        </g>


        <!-- poça de barro central -->
        <ellipse cx="40" cy="40" rx="13" ry="8" fill="#9a542e" opacity="0.5" />

        <ellipse cx="40" cy="38" rx="8" ry="4" fill="#c47745" opacity="0.6" />


    </pattern>
    <pattern id="mountainPattern" patternUnits="userSpaceOnUse" width="173.2" height="300" patternTransform="scale(1)">

        <!-- Fundo da montanha (cinza claro) -->
        <rect width="173.2" height="300" fill="#9a9a9a" />

        <!-- Hexágono 1 - Linha de montanhas -->
        <g>
            <!-- Camada de base/terra -->
            <rect y="40" width="173.2" height="60" fill="#7a7a7a" />

            <!-- Manchas de terreno -->
            <circle cx="43" cy="70" r="30" fill="#6e6e6e" opacity="0.3" />
            <circle cx="130" cy="75" r="25" fill="#8a8a8a" opacity="0.25" />

            <!-- Montanha principal (centro) -->
            <g transform="translate(50,5)">
                <polygon points="0,65 36,0 73,65" fill="#a0a0a0" />
                <polygon points="36,0 36,65 73,65" fill="#757575" opacity="0.4" />
                <polygon points="36,0 27,22 45,22" fill="#e8e8e8" opacity="0.8" />
                <line x1="22" y1="42" x2="36" y2="22" stroke="#888" stroke-width="1" opacity="0.3" />
                <line x1="43" y1="48" x2="52" y2="30" stroke="#888" stroke-width="1" opacity="0.3" />
                <polygon points="36,0 30,17 42,17" fill="#f0f0f0" opacity="0.5" />
            </g>

            <!-- Montanha direita -->
            <g transform="translate(115,15)">
                <polygon points="0,50 25,5 50,50" fill="#b0b0b0" />
                <polygon points="25,5 25,50 50,50" fill="#808080" opacity="0.4" />
                <polygon points="25,5 18,22 32,22" fill="#e8e8e8" opacity="0.7" />
                <line x1="14" y1="32" x2="25" y2="18" stroke="#999" stroke-width="1" opacity="0.3" />
                <line x1="32" y1="35" x2="38" y2="23" stroke="#999" stroke-width="1" opacity="0.3" />
            </g>

            <!-- Montanha fundo esquerda -->
            <g transform="translate(10,35)">
                <polygon points="0,32 20,8 40,32" fill="#c0c0c0" />
                <polygon points="20,8 20,32 40,32" fill="#8a8a8a" opacity="0.3" />
                <polygon points="20,8 13,21 27,21" fill="#e8e8e8" opacity="0.5" />
            </g>

            <!-- Montanha fundo direita -->
            <g transform="translate(145,38)">
                <polygon points="0,28 17,6 34,28" fill="#b8b8b8" />
                <polygon points="17,6 17,28 34,28" fill="#7a7a7a" opacity="0.3" />
                <polygon points="17,6 11,18 23,18" fill="#e8e8e8" opacity="0.5" />
            </g>

            <!-- Montanha extra fundo -->
            <g transform="translate(80,38)">
                <polygon points="0,25 15,10 30,25" fill="#c8c8c8" opacity="0.6" />
                <polygon points="15,10 15,25 30,25" fill="#9a9a9a" opacity="0.3" />
            </g>

            <!-- Detalhes de rochas -->
            <g fill="#6d6d6d" opacity="0.4">
                <ellipse cx="75" cy="68" rx="6" ry="3" transform="rotate(-20 75 68)" />
                <ellipse cx="25" cy="78" rx="5" ry="2.5" transform="rotate(15 25 78)" />
                <ellipse cx="148" cy="65" rx="5" ry="2.5" transform="rotate(-10 148 65)" />
                <ellipse cx="108" cy="75" rx="4" ry="2" transform="rotate(30 108 75)" />
            </g>

            <!-- Sombras de profundidade -->
            <rect y="72" width="173.2" height="28" fill="#5a5a5a" opacity="0.2" />
        </g>

        <!-- Hexágono 2 (deslocado para baixo) -->
        <g transform="translate(0,150)">
            <!-- Camada de base/terra -->
            <rect y="40" width="173.2" height="60" fill="#7a7a7a" />

            <!-- Manchas de terreno -->
            <circle cx="130" cy="70" r="30" fill="#6e6e6e" opacity="0.3" />
            <circle cx="43" cy="75" r="25" fill="#8a8a8a" opacity="0.25" />

            <!-- Montanha principal (centro) - invertida -->
            <g transform="translate(87,5)">
                <polygon points="0,65 36,0 73,65" fill="#a0a0a0" />
                <polygon points="36,0 36,65 73,65" fill="#757575" opacity="0.4" />
                <polygon points="36,0 27,22 45,22" fill="#e8e8e8" opacity="0.8" />
                <line x1="22" y1="42" x2="36" y2="22" stroke="#888" stroke-width="1" opacity="0.3" />
                <line x1="43" y1="48" x2="52" y2="30" stroke="#888" stroke-width="1" opacity="0.3" />
                <polygon points="36,0 30,17 42,17" fill="#f0f0f0" opacity="0.5" />
            </g>

            <!-- Montanha esquerda -->
            <g transform="translate(25,15)">
                <polygon points="0,50 25,5 50,50" fill="#b0b0b0" />
                <polygon points="25,5 25,50 50,50" fill="#808080" opacity="0.4" />
                <polygon points="25,5 18,22 32,22" fill="#e8e8e8" opacity="0.7" />
                <line x1="14" y1="32" x2="25" y2="18" stroke="#999" stroke-width="1" opacity="0.3" />
                <line x1="32" y1="35" x2="38" y2="23" stroke="#999" stroke-width="1" opacity="0.3" />
            </g>

            <!-- Montanha fundo direita -->
            <g transform="translate(133,35)">
                <polygon points="0,32 20,8 40,32" fill="#c0c0c0" />
                <polygon points="20,8 20,32 40,32" fill="#8a8a8a" opacity="0.3" />
                <polygon points="20,8 13,21 27,21" fill="#e8e8e8" opacity="0.5" />
            </g>

            <!-- Montanha fundo esquerda -->
            <g transform="translate(-5,38)">
                <polygon points="0,28 17,6 34,28" fill="#b8b8b8" />
                <polygon points="17,6 17,28 34,28" fill="#7a7a7a" opacity="0.3" />
                <polygon points="17,6 11,18 23,18" fill="#e8e8e8" opacity="0.5" />
            </g>

            <!-- Detalhes de rochas -->
            <g fill="#6d6d6d" opacity="0.4">
                <ellipse cx="98" cy="68" rx="6" ry="3" transform="rotate(-20 98 68)" />
                <ellipse cx="148" cy="78" rx="5" ry="2.5" transform="rotate(15 148 78)" />
                <ellipse cx="25" cy="65" rx="5" ry="2.5" transform="rotate(-10 25 65)" />
                <ellipse cx="65" cy="75" rx="4" ry="2" transform="rotate(30 65 75)" />
            </g>

            <!-- Sombras de profundidade -->
            <rect y="72" width="173.2" height="28" fill="#5a5a5a" opacity="0.2" />
        </g>

    </pattern>
    <pattern id="wheatPattern" patternUnits="userSpaceOnUse" width="80" height="80">

        <!-- Fundo do campo -->
        <rect width="80" height="80" fill="#d6b64c" />


        <!-- variações do terreno -->
        <circle cx="15" cy="20" r="22" fill="#c39f38" opacity="0.35" />

        <circle cx="65" cy="60" r="25" fill="#e3c761" opacity="0.35" />


        <!-- Feixe de trigo 1 -->
        <g transform="translate(20,18)">

            <!-- caule -->
            <path d="
            M10 40
            Q8 25 12 5" stroke="#8b6b25" stroke-width="2" fill="none" />


            <!-- espigas -->
            <g fill="#f2d86b">

                <ellipse cx="10" cy="8" rx="3" ry="7" />

                <ellipse cx="7" cy="14" rx="3" ry="7" />

                <ellipse cx="14" cy="18" rx="3" ry="7" />

            </g>

        </g>


        <!-- Feixe de trigo 2 menor -->
        <g transform="translate(55,45) scale(0.7)">

            <path d="
            M10 40
            Q8 25 12 5" stroke="#8b6b25" stroke-width="2" fill="none" />


            <g fill="#f5db75">

                <ellipse cx="10" cy="8" rx="3" ry="7" />

                <ellipse cx="7" cy="14" rx="3" ry="7" />

                <ellipse cx="14" cy="18" rx="3" ry="7" />

            </g>

        </g>


        <!-- Pequenas folhas/grama -->
        <g fill="#a8862e" opacity="0.8">

            <path d="
            M45 25
            Q50 15 55 25
            Q50 22 45 25" />

            <path d="
            M30 65
            Q35 55 40 65
            Q35 62 30 65" />

        </g>


        <!-- Pequenos grãos espalhados -->
        <g fill="#f0d56a">

            <circle cx="45" cy="15" r="2" />

            <circle cx="70" cy="30" r="2.5" />

            <circle cx="35" cy="50" r="2" />

            <circle cx="15" cy="60" r="2" />

        </g>


        <!-- sombras suaves -->
        <circle cx="25" cy="30" r="8" fill="#9b7c29" opacity="0.15" />

    </pattern>
    <pattern id="sheepPattern" patternUnits="userSpaceOnUse" width="80" height="80">

        <!-- Fundo do pasto -->
        <rect width="80" height="80" fill="#7fb05a" />


        <!-- variações de grama -->
        <circle cx="18" cy="20" r="22" fill="#6a9c4b" opacity="0.35" />

        <circle cx="65" cy="55" r="25" fill="#93c56b" opacity="0.35" />


        <!-- tufo de grama 1 -->
        <g transform="translate(15,45)" fill="#4f8a3d">

            <path d="
            M0 15
            Q5 0 8 15
            Q12 2 15 15
            Q20 5 22 15
            Z" />

        </g>


        <!-- tufo de grama 2 -->
        <g transform="translate(55,20) scale(0.7)" fill="#568f3f">

            <path d="
            M0 15
            Q5 0 8 15
            Q12 2 15 15
            Q20 5 22 15
            Z" />

        </g>


        <!-- Ovelha 1 -->
        <g transform="translate(18,15)">

            <!-- corpo -->
            <ellipse cx="12" cy="14" rx="10" ry="7" fill="#f1f1e8" />

            <!-- cabeça -->
            <circle cx="22" cy="13" r="4" fill="#4b4b43" />

            <!-- perninhas -->
            <line x1="7" y1="20" x2="7" y2="25" stroke="#4b4b43" stroke-width="1.5" />

            <line x1="17" y1="20" x2="17" y2="25" stroke="#4b4b43" stroke-width="1.5" />

            <!-- olho -->
            <circle cx="23" cy="12" r="0.8" fill="#111" />

        </g>


        <!-- Ovelha menor -->
        <g transform="translate(55,55) scale(0.65)">

            <ellipse cx="12" cy="14" rx="10" ry="7" fill="#eeeeE5" />

            <circle cx="22" cy="13" r="4" fill="#4b4b43" />

            <line x1="7" y1="20" x2="7" y2="25" stroke="#4b4b43" stroke-width="1.5" />

            <line x1="17" y1="20" x2="17" y2="25" stroke="#4b4b43" stroke-width="1.5" />

        </g>


        <!-- pequenas flores -->
        <g fill="#f5e7a5">

            <circle cx="45" cy="18" r="2" />

            <circle cx="70" cy="35" r="1.8" />

            <circle cx="38" cy="65" r="2" />

        </g>


        <!-- pequenas folhas -->
        <g fill="#4d873b" opacity="0.8">

            <ellipse cx="35" cy="30" rx="4" ry="2" transform="rotate(-30 35 30)" />

            <ellipse cx="65" cy="70" rx="5" ry="2" transform="rotate(25 65 70)" />

        </g>

    </pattern>
    <pattern id="desertPattern" patternUnits="userSpaceOnUse" width="80" height="80">

        <!-- Fundo de areia -->
        <rect width="80" height="80" fill="#d8bd73" />


        <!-- variações de areia -->
        <circle cx="20" cy="25" r="28" fill="#cbaa5d" opacity="0.3" />

        <circle cx="65" cy="60" r="30" fill="#e6ce8a" opacity="0.35" />


        <!-- pequenas dunas -->
        <path d="
        M0 55
        Q20 40 40 55
        Q60 70 80 55
        L80 80
        L0 80
        Z" fill="#c9aa5f" opacity="0.35" />


        <path d="
        M0 65
        Q25 50 50 65
        Q65 75 80 65" fill="none" stroke="#b99750" stroke-width="2" opacity="0.4" />


        <!-- ondas de areia -->
        <g fill="none" stroke="#efd99a" stroke-width="1.5" opacity="0.6">

            <path d="
            M10 18
            Q25 12 40 18" />

            <path d="
            M45 35
            Q60 29 75 35" />

            <path d="
            M5 72
            Q20 66 35 72" />

        </g>


        <!-- pequenas pedras -->
        <g fill="#a9894d" opacity="0.7">

            <ellipse cx="18" cy="45" rx="5" ry="3" transform="rotate(-20 18 45)" />

            <ellipse cx="60" cy="20" rx="4" ry="2.5" transform="rotate(15 60 20)" />

            <ellipse cx="70" cy="70" rx="5" ry="3" transform="rotate(-10 70 70)" />

        </g>


        <!-- pequenos grãos de areia -->
        <g fill="#b99550" opacity="0.6">

            <circle cx="35" cy="25" r="1.5" />

            <circle cx="50" cy="55" r="1.5" />

            <circle cx="25" cy="65" r="1.2" />

            <circle cx="72" cy="42" r="1.2" />

        </g>


    </pattern>
</defs>