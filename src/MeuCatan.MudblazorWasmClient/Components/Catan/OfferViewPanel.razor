<div class="offer-view-panel-host">
    <MudPaper Class="offer-view-panel pa-3" Elevation="6">
        <MudStack Row="true" Spacing="2">
            <MudStack Class="flex-grow-1">
                <MudStack Row="true">
                    <MudAvatar Size="Size.Small" Class="offer-avatar"
                               Style="@($"background-color:{AvatarColor}; color:#fff;")">
                        <MudIcon Icon="@Icons.Material.Filled.Person" />
                    </MudAvatar>
                    <MudIcon Icon="@Icons.Material.Filled.ArrowDownward" Style="color:green;" />
                    <div class="offer-resource-row">
                        @foreach (var resource in OfferedResourceEntries)
                        {
                            <ResourceCard Token=true ResourceType="@resource.Key" Count="@resource.Value" Disabled="true" />
                        }
                    </div>
                </MudStack>

                <MudStack Row="true">
                    <MudAvatar Size="Size.Small" Class="offer-avatar"
                               Style="@($"background-color:{ViewerAvatarColor}; color:#fff;")">
                        <MudIcon Icon="@Icons.Material.Filled.Person" />
                    </MudAvatar>
                    <MudIcon Icon="@Icons.Material.Filled.ArrowUpward" Style="color:#dc2626;" />
                    <div class="offer-resource-row">
                        @foreach (var resource in AskedResourceEntries)
                        {
                            <ResourceCard Token=true ResourceType="@resource.Key" Count="@resource.Value" Disabled="true" />
                        }
                    </div>
                </MudStack>
            </MudStack>

            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.End">
                <MudTooltip Text=" Recusar">
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Variant="Variant.Outlined"
                                   Color="Color.Default" aria-label="Recusar" />
                </MudTooltip>
                <MudTooltip Text="Editar">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Variant="Variant.Outlined"
                                   Color="Color.Secondary" aria-label="Editar" />
                </MudTooltip>
                <MudTooltip Text="Aceitar">
                    <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small" Variant="Variant.Filled"
                                   Color="Color.Primary" aria-label="Aceitar" />
                </MudTooltip>
            </MudStack>
        </MudStack>
    </MudPaper>
</div>

@code {
    private static readonly string[] ResourceOrder =
    [
        "madeira",
        "argila",
        "ovelha",
        "trigo",
        "pedra"
    ];

    [Parameter, EditorRequired]
    public TradeOfferResponse Offer { get; set; } = default!;

    [Parameter]
    public string? ViewerColor { get; set; }

    private string AvatarColor => PlayerColorUtils.ToHex(Offer.OffererColor);
    private string ViewerAvatarColor => PlayerColorUtils.ToHex(ViewerColor);

    private List<KeyValuePair<string, int>> OfferedResourceEntries => BuildResourceEntries(Offer.OfferedResources);
    private List<KeyValuePair<string, int>> AskedResourceEntries => BuildResourceEntries(Offer.AskedResources);

    private static List<KeyValuePair<string, int>> BuildResourceEntries(IReadOnlyDictionary<string, int> resources)
    {
        return resources
            .Where(pair => pair.Value > 0)
            .OrderBy(pair =>
            {
                var index = Array.IndexOf(ResourceOrder, pair.Key);
                return index >= 0 ? index : int.MaxValue;
            })
            .ThenBy(pair => pair.Key, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }
}