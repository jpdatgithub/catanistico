@using System.Globalization;

<g transform="translate(@F(X),@F(Y - 16))">
    <defs>
        <linearGradient id="@GradientId" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="@LightColor" />
            <stop offset="100%" stop-color="@DarkColor" />
        </linearGradient>
    </defs>

    <ellipse cx="0" cy="28" rx="22" ry="7" fill="#111111" opacity="0.22" />

    <g transform="translate(-24,-24) scale(0.096)">
        <!-- silhueta de fundo preenchida com o gradiente da cor do jogador -->
        <path
        d="M179.48,100 L320,175 L307.576,206 V449.788 H51.576 V206 L39,175 Z M331.576,17.788 h96 v18 h-96 z M347.576,35 h64 v145 h-64 z M339.576,176 h144 v26 h-144 z M323.576,202 h144 v248 h-144 z M483.576,113.788 v48 H333.552 l-91.2,-48 z"
        fill="url(#@GradientId)" />
        <!-- traços originais do cidade.svg em preto -->
