        fill="#000000" />
        <path
        d="M131.576,273.788h96v-96h-96V273.788z M187.576,193.788h24v24h-24V193.788z M187.576,233.788h24v24h-24V233.788z M147.576,193.788h24v24h-24V193.788z M147.576,233.788h24v24h-24V233.788z"
