<div class="resource-trade-overlay">
    <MudPaper Class="resource-trade-panel pa-3" Elevation="6">
        <MudStack Spacing="2">
            @if (IsOpen)
            {
                <MudStack Spacing="1" Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween">
                    <div class="trade-resource-row trade-resource-row--selected">
                        @foreach (var resource in ResourceOrder)
                        {
                            <ResourceCard Token=true ResourceType="@resource" Count=0
                                          OnClick="@(() => AddAskedResource(resource))" />
                        }
                    </div>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Variant="Variant.Text"
                                   Color="Color.Default" aria-label="Fechar interface de trocas" OnClick="HandleClose" />
                </MudStack>
                <MudStack Row="true">
                    <MudStack Class="flex-grow-1" Justify="Justify.SpaceAround">
                        <MudStack Row="true">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Filled.ArrowDownward" Style="color:green;"
                                             Class="trade-arrow" />

                                    <MudAvatar Size="Size.Small" Class="trade-avatar"
                                               Style="@($"background-color:gray; color:#fff;")">
                                        <MudIcon Icon="@Icons.Material.Filled.Person" />
                                    </MudAvatar>
                                </MudStack>
                            </MudStack>

                            <MudStack Spacing="1">
                                @if (AskedResourceEntries.Count == 0)
                                {
                                    <div class="trade-empty-slot">
                                        <MudText Typo="Typo.body2">Clique em uma carta acima para pedi-la.</MudText>
                                    </div>
                                }
                                else
                                {
                                    <div class="trade-resource-row trade-resource-row--selected">
                                        @foreach (var resource in AskedResourceEntries)
                                        {
                                            <ResourceCard Token=true ResourceType="@resource.Key" Count="@resource.Value"
                                                          OnClick="@(() => RemoveAskedResource(resource.Key))" />
                                        }
                                    </div>
                                }
                            </MudStack>
                        </MudStack>
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start">
                            <MudStack>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                        <MudIcon Icon="@Icons.Material.Filled.ArrowUpward" Style="color:#dc2626;"
                                                 Class="trade-arrow" />

                                        <MudAvatar Size="Size.Small" Class="trade-avatar"
                                                   Style="@($"background-color:{AvatarColor}; color:#fff;")">
                                            <MudIcon Icon="@Icons.Material.Filled.Person" />
                                        </MudAvatar>
                                    </MudStack>
                                </MudStack>
                            </MudStack>

                            <MudStack Class="flex-grow-1" Spacing="1">
                                @if (OfferedResourceEntries.Count == 0)
                                {
                                    <div class="trade-empty-slot">
                                        <MudText Typo="Typo.body2">Clique em uma carta para movê-la para a troca.</MudText>
                                    </div>
                                }
                                else
                                {
                                    <div class="trade-resource-row trade-resource-row--selected">
                                        @foreach (var resource in OfferedResourceEntries)
                                        {
                                            <ResourceCard Token=true ResourceType="@resource.Key" Count="@resource.Value"
                                                          OnClick="@(() => HandleSelectedResourceClick(resource.Key))" />
                                        }
                                    </div>
                                }
                            </MudStack>
                        </MudStack>
                    </MudStack>
                    <MudStack>
                        <MudStack AlignItems="AlignItems.Center">
                            <MudTooltip Text="@BankTradeRatesTooltipText" Placement="Placement.Right">
                                <MudIcon Icon="@Icons.Material.Filled.Storefront" Size="Size.Small" />
                                <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
                            </MudTooltip>
                        </MudStack>

                        <MudButton>
                            <MudIcon Icon="@Icons.Material.Filled.SwapVert" Size="Size.Small" />
                            <MudIcon Icon="@Icons.Material.Filled.Storefront" Size="Size.Small" />
                        </MudButton>

                        <MudSpacer />

                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!CanOffer)"
                                   OnClick="HandleOffer">
                            <MudIcon Icon="@Icons.Material.Filled.SwapVert" Size="Size.Small" />
                            <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" />
                        </MudButton>
                    </MudStack>
                </MudStack>
            }
        </MudStack>
    </MudPaper>
</div>

@code {
    private static readonly string[] ResourceOrder =
    [
        "madeira",
        "argila",
        "ovelha",
        "trigo",
        "pedra"
    ];

    [Parameter, EditorRequired]
    public GamePlayerStateResponse Player { get; set; } = default!;

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public IReadOnlyDictionary<string, int> OfferedResources { get; set; } = new Dictionary<string, int>();

    [Parameter]
    public Dictionary<string, int> AskedResources { get; set; } = new Dictionary<string, int>();

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback<string> OnSelectedResourceClicked { get; set; }

    [Parameter]
    public EventCallback OnOffer { get; set; }

    private string AvatarColor => PlayerColorUtils.ToHex(Player.Cor);

    private List<KeyValuePair<string, int>> AskedResourceEntries => BuildResourceEntries(AskedResources);
    private List<KeyValuePair<string, int>> OfferedResourceEntries => BuildResourceEntries(OfferedResources);
    private bool CanOffer => OfferedResourceEntries.Count > 0 && AskedResourceEntries.Count > 0 && OnOffer.HasDelegate;
    private string BankTradeRatesTooltipText => BuildBankTradeRatesTooltipText();

    private async Task HandleClose()
    {
        if (!OnClose.HasDelegate)
        {
            return;
        }

        await OnClose.InvokeAsync();
    }

    private async Task HandleSelectedResourceClick(string resourceType)
    {
        if (!OnSelectedResourceClicked.HasDelegate)
        {
            return;
        }

        await OnSelectedResourceClicked.InvokeAsync(resourceType);
    }

    private async Task HandleOffer()
    {
        if (!CanOffer)
        {
            return;
        }

        await OnOffer.InvokeAsync();
    }

    private static List<KeyValuePair<string, int>> BuildResourceEntries(IReadOnlyDictionary<string, int>? resources)
    {
        var source = resources ?? new Dictionary<string, int>();

        return source
            .Where(pair => pair.Value > 0)
            .OrderBy(pair =>
            {
                var index = Array.IndexOf(ResourceOrder, pair.Key);
                return index >= 0 ? index : int.MaxValue;
            })
            .ThenBy(pair => pair.Key, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private string BuildBankTradeRatesTooltipText()
    {
        var rates = Player?.BankTradeRates;
        if (rates is null || rates.Count == 0)
        {
            return "Banco: 4:1 para todos os recursos.";
        }

        var parts = ResourceOrder
            .Select(resource =>
            {
                var rate = rates.GetValueOrDefault(resource, 4);
                return $"{FormatResourceLabel(resource)} {rate}:1";
            })
            .ToList();

        return $"Banco: {string.Join(", ", parts)}.";
    }

    private static string FormatResourceLabel(string resource)
    {
        return resource.ToLowerInvariant() switch
        {
            "madeira" => "Madeira",
            "argila" => "Argila",
            "ovelha" => "Ovelha",
            "trigo" => "Trigo",
            "pedra" => "Pedra",
            _ => resource
        };
    }

    private void AddAskedResource(string resourceType)
    {
        if (!OfferedResources.ContainsKey(resourceType))
        {
            if (AskedResources.ContainsKey(resourceType))
            {
                AskedResources[resourceType]++;
            }
            else
            {
                AskedResources[resourceType] = 1;
            }
        }
    }

    private void RemoveAskedResource(string resourceType)
    {
        if (AskedResources.ContainsKey(resourceType))
        {
            AskedResources[resourceType]--;
            if (AskedResources[resourceType] <= 0)
            {
                AskedResources.Remove(resourceType);
            }
        }
    }
}