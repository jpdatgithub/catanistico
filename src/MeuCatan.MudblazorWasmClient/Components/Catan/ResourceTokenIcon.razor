<img class="resource-token-icon" src="@IconPath" alt="@AccessibleLabel" draggable="false" />

@code {
    [Parameter, EditorRequired]
    public string ResourceType { get; set; } = string.Empty;

    private string IconPath => ResourceType.ToLowerInvariant() switch
    {
        "madeira" => "images/resources/madeira.svg",
        "argila" => "images/resources/argila.svg",
        "ovelha" => "images/resources/ovelha.svg",
        "trigo" => "images/resources/trigo.svg",
        "pedra" => "images/resources/pedra.svg",
        "desenvolvimento" => "images/resources/desenvolvimento.svg",
        "cavaleiro" => "images/resources/cavaleiro.svg",
        "ponto-de-vitoria" => "images/resources/victorypoint.svg",
        "roadbuilder" => "images/resources/roadbuilder.svg",
        "plus2resources" => "images/resources/plus2resources.svg",
        "monopoly" => "images/resources/monopoly.svg",
        _ => "images/resources/pedra.svg"
    };

    private string AccessibleLabel => ResourceType.ToLowerInvariant() switch
    {
        "madeira" => "Madeira",
        "argila" => "Argila",
        "ovelha" => "Ovelha",
        "trigo" => "Trigo",
        "pedra" => "Pedra",
        "desenvolvimento" => "Carta de desenvolvimento",
        "cavaleiro" => "Cavaleiro",
        "ponto-de-vitoria" => "Ponto de vitoria",
        "roadbuilder" => "Construtor de estradas",
        "plus2resources" => "Mais 2 recursos",
        "monopoly" => "Monopolio",
        _ => ResourceType
    };
}