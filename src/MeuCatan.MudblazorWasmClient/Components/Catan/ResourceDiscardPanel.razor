<div class="resource-discard-overlay">
    <MudPaper Class="pa-3" Elevation="6"
              Style="border:1px solid rgba(15, 23, 42, 0.16); background:linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(250, 250, 250, 0.95) 100%); box-shadow:0 12px 28px rgba(15, 23, 42, 0.14); backdrop-filter:blur(6px); border-radius:16px; min-width:280px;">
        <MudStack Spacing="2">
            @if (IsOpen)
            {
                <MudText Typo="Typo.h6">Número do ladrão! Você deve descartar @RequiredAmount cartas</MudText>
                <MudText Typo="Typo.caption" Class="resource-discard-progress">
                    Selecionadas: @SelectedCount/@RequiredAmount
                </MudText>

                <div class="discard-resource-row discard-resource-row--selected">
                    @foreach (var resource in SelectedResourceEntries)
                    {
                        <ResourceCard Token="true" ResourceType="@resource.Key" Count="@resource.Value"
                                      OnClick="@(() => HandleSelectedResourceClick(resource.Key))" />
                    }
                </div>

                <MudStack Row="true" Justify="Justify.FlexEnd">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!CanConfirm)"
                               OnClick="HandleConfirm">
                        Confirmar descarte
                    </MudButton>
                </MudStack>
            }
        </MudStack>
    </MudPaper>
</div>

@code {
    private static readonly string[] ResourceOrder =
    [
        "madeira",
        "argila",
        "ovelha",
        "trigo",
        "pedra"
    ];

    [Parameter, EditorRequired]
    public GamePlayerStateResponse Player { get; set; } = default!;

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public int RequiredAmount { get; set; }

    [Parameter]
    public IReadOnlyDictionary<string, int> SelectedResources { get; set; } = new Dictionary<string, int>();

    [Parameter]
    public EventCallback<string> OnSelectedResourceClicked { get; set; }

    [Parameter]
    public EventCallback OnConfirm { get; set; }

    private int SelectedCount => SelectedResources.Values.Sum();

    private bool CanConfirm => IsOpen
        && RequiredAmount > 0
        && SelectedCount == RequiredAmount
        && OnConfirm.HasDelegate;

    private List<KeyValuePair<string, int>> SelectedResourceEntries => BuildResourceEntries(SelectedResources);

    private async Task HandleSelectedResourceClick(string resourceType)
    {
        if (!OnSelectedResourceClicked.HasDelegate)
        {
            return;
        }

        await OnSelectedResourceClicked.InvokeAsync(resourceType);
    }

    private async Task HandleConfirm()
    {
        if (!CanConfirm)
        {
            return;
        }

        await OnConfirm.InvokeAsync();
    }

    private static List<KeyValuePair<string, int>> BuildResourceEntries(IReadOnlyDictionary<string, int>? resources)
    {
        var source = resources ?? new Dictionary<string, int>();

        return source
            .Where(pair => pair.Value > 0)
            .OrderBy(pair =>
            {
                var index = Array.IndexOf(ResourceOrder, pair.Key);
                return index >= 0 ? index : int.MaxValue;
            })
            .ThenBy(pair => pair.Key, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }
}
