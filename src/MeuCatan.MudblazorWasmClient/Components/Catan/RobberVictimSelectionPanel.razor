<div class="robber-victim-overlay">
    <MudPaper Class="pa-3" Elevation="6"
              Style="border:1px solid rgba(15, 23, 42, 0.16); background:linear-gradient(180deg, rgba(255, 255, 255, 0.97) 0%, rgba(250, 250, 250, 0.95) 100%); box-shadow:0 12px 28px rgba(15, 23, 42, 0.14); border-radius:16px;">
        <MudStack Spacing="2">
            <MudText Typo="Typo.h6">Escolha de quem o ladrão vai roubar</MudText>
            <MudText Typo="Typo.caption">Selecione um jogador adjacente ao hexágono escolhido.</MudText>

            <MudStack Spacing="1">
                @foreach (var victim in Victims)
                {
                    var isSelected = SelectedPlayerId == victim.UsuarioId;
                    var optionClass = $"robber-victim-option{(isSelected ? " robber-victim-option--selected" :
                string.Empty)}";
                    <button type="button" class="@optionClass" aria-pressed="@isSelected"
                            @onclick="() => HandleVictimSelected(victim.UsuarioId)">
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                <MudAvatar Size="Size.Small"
                                           Style="@($"width:28px; height:28px; background-color:{PlayerColorUtils.ToHex(victim.Cor)}; color:#fff;")">
                                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                                </MudAvatar>
                                <MudText>@victim.Nome</MudText>
                            </MudStack>

                            <MudText Typo="Typo.caption">@victim.Resources.Values.Sum() carta(s)</MudText>
                        </MudStack>
                    </button>
                }
            </MudStack>

            <MudStack Row="true" Justify="Justify.FlexEnd">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(SelectedPlayerId is null)"
                           OnClick="HandleConfirm">
                    Confirmar
                </MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>
</div>

@code {
    [Parameter]
    public IReadOnlyList<GamePlayerStateResponse> Victims { get; set; } = [];

    [Parameter]
    public int? SelectedPlayerId { get; set; }

    [Parameter]
    public EventCallback<int> OnVictimSelected { get; set; }

    [Parameter]
    public EventCallback OnConfirm { get; set; }

    private Task HandleVictimSelected(int playerId)
    {
        return OnVictimSelected.InvokeAsync(playerId);
    }

    private Task HandleConfirm()
    {
        if (SelectedPlayerId is null || !OnConfirm.HasDelegate)
        {
            return Task.CompletedTask;
        }

        return OnConfirm.InvokeAsync();
    }
}
