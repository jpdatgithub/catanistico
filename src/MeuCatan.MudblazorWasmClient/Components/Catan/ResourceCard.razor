<MudTooltip Text="@DisplayName" Inline="true">
    <span style="display:inline-flex;">
        <button type="button"
                class="resource-card-button @(Token ? "resource-card-button--token" : string.Empty) @(OnClick.HasDelegate ? "is-clickable" : string.Empty) @(Selected ? "is-selected" : string.Empty) @(Disabled && GrayscaleWhenDisabled ? "is-disabled-muted" : string.Empty)"
                disabled="@Disabled" @onclick="HandleClick" aria-label="@AccessibleLabel">
            @if (Token)
            {
                <span class="resource-token @ResourceClass">
                    <ResourceTokenIcon ResourceType="@ResourceType" ShowTooltip="false" />
                    <ResourceQuantityBadge Count="@Count" />
                </span>
            }
            else
            {
                <div class="resource-card-shell @(Compact ? "resource-card-shell--compact" : string.Empty)">
                    @if (Count > 2)
                    {
                        <div class="resource-card-layer @ResourceClass layer-back"></div>
                    }

                    @if (Count > 1)
                    {
                        <div class="resource-card-layer @ResourceClass layer-middle"></div>
                    }

                    <div class="resource-card @ResourceClass @(Compact ? "resource-card--compact" : string.Empty)">
                        <ResourceTokenIcon ResourceType="@ResourceType" ShowTooltip="false" />
                        @if (Count > 0)
                        {
                            <span class="resource-card-count">@Count</span>
                        }
                    </div>
                </div>
            }
        </button>
    </span>
</MudTooltip>

@code {
    [Parameter, EditorRequired]
    public string ResourceType { get; set; } = string.Empty;

    [Parameter]
    public int Count { get; set; }

    [Parameter]
    public bool Compact { get; set; }

    [Parameter]
    public bool Token { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool GrayscaleWhenDisabled { get; set; }

    [Parameter]
    public bool Selected { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    private string ResourceClass => ResourceType.ToLowerInvariant() switch
    {
        "madeira" => "resource-madeira",
        "argila" => "resource-argila",
        "ovelha" => "resource-ovelha",
        "trigo" => "resource-trigo",
        "pedra" => "resource-pedra",
        "coringa" => "resource-coringa",
        "cavaleiro" => "resource-cavaleiro",
        "ponto-de-vitoria" => "resource-ponto-de-vitoria",
        "roadbuilder" => "resource-roadbuilder",
        "plus2resources" => "resource-plus2resources",
        "monopoly" => "resource-monopoly",
        _ => "resource-default"
    };

    private string DisplayName => ResourceType.ToLowerInvariant() switch
    {
        "madeira" => "Madeira",
        "argila" => "Argila",
        "ovelha" => "Ovelha",
        "trigo" => "Trigo",
        "pedra" => "Pedra",
        "coringa" => "Coringa",
        "cavaleiro" => "Cavaleiro",
        "ponto-de-vitoria" => "Ponto de vitoria",
        "roadbuilder" => "Construtor de estradas",
        "plus2resources" => "Mais 2 recursos",
        "monopoly" => "Monopolio",
        _ => ResourceType
    };

    private string AccessibleLabel => Count > 0 ? $"{DisplayName}: {Count}" : DisplayName;

    private async Task HandleClick()
    {
        if (!OnClick.HasDelegate || Disabled)
        {
            return;
        }

        await OnClick.InvokeAsync();
    }
}
